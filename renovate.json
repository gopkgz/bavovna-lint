{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/\\.custom-gcl\\.ya?ml$/"],
      "matchStrings": ["version:\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "github.com/golangci/golangci-lint/v2",
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/\\.github/workflows/ci\\.ya?ml$/"],
      "matchStrings": [
        "go install github\\.com/golangci/golangci-lint/v2/cmd/golangci-lint@(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "github.com/golangci/golangci-lint/v2",
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/images/ci-go-(?:cgo|nocgo)/Dockerfile$/"],
      "matchStrings": ["ENV GOTOOLCHAIN=go(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "go",
      "datasourceTemplate": "golang-version"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/\\.github/workflows/go-images\\.ya?ml$/"],
      "matchStrings": ["GO_VERSION:\\s*(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "go",
      "datasourceTemplate": "golang-version"
    }
  ],
  "packageRules": [
    {
      "description": "Keep every Go toolchain pin in one update",
      "groupName": "Go toolchain",
      "matchPackageNames": [
        "go",
        "golang",
        "ghcr.io/gopkgz/bavovna-lint-ci-go-cgo",
        "ghcr.io/gopkgz/bavovna-lint-ci-go-nocgo"
      ],
      "rangeStrategy": "bump"
    }
  ]
}
