{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/\\.custom-gcl\\.ya?ml$/"],
      "matchStrings": ["version:\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "github.com/golangci/golangci-lint/v2",
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/\\.github/workflows/ci\\.ya?ml$/"],
      "matchStrings": [
        "go install github\\.com/golangci/golangci-lint/v2/cmd/golangci-lint@(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "github.com/golangci/golangci-lint/v2",
      "datasourceTemplate": "go"
    },
    {
      "description": "Go toolchain pins in CI and release workflows",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/(?:ci|toolchain-release)\\.yml$/"],
      "matchStrings": ["GOTOOLCHAIN: go(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "go",
      "datasourceTemplate": "golang-version",
      "versioningTemplate": "semver"
    },
    {
      "description": "Go release build image",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/toolchain-release\\.yml$/"],
      "matchStrings": [
        "registry\\.p73\\.dev/infra/ci-go-nocgo:(?<currentValue>\\d+\\.\\d+\\.\\d+-alpine)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "depNameTemplate": "registry.p73.dev/infra/ci-go-nocgo",
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Update every Go toolchain pin together",
      "matchDatasources": ["docker", "golang-version"],
      "matchPackageNames": [
        "go",
        "golang",
        "registry.p73.dev/infra/ci-go-cgo",
        "registry.p73.dev/infra/ci-go-nocgo"
      ],
      "groupName": "Go toolchain",
      "groupSlug": "go-toolchain",
      "separateMajorMinor": false
    }
  ]
}
